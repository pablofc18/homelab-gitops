{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^manifests/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions annotated with a '# renovate:' comment in the Makefile and CI scripts",
      "managerFilePatterns": ["/^Makefile$/", "/^scripts/.+\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+_VERSION\\s*:?=\\s*(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "ArgoCD install manifest, pinned by its URL in the kustomization ArgoCD syncs itself from",
      "managerFilePatterns": ["/^manifests/argocd/kustomization\\.yaml$/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[^/]+)/manifests/install\\.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "argoproj/argo-cd"
    }
  ]
}
